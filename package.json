{
  "name": "karita",
  "version": "1.0.0",
  "private": true,
  "description": "Multi-location parking slot reservation system",
  "type": "module",
  "scripts": {
    "build": "vite build",
    "dev": "vite",
    "start": "npm run build && cd backend && ./mvnw spring-boot:run",
    "test": "npm run build && node tests/smoke.mjs",
    "test:backend": "cd backend && ./mvnw test",
    "test:all": "npm run test:backend && npm test",
    "screens": "npm run build && node tests/screens.mjs"
  },
  "dependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^5.1.0",
    "vite": "^7.1.0"
  },
  "engines": {
    "node": ">=18"
  }
}
